# Contentful Space ID
CONTENTFUL_SPACE_ID=YOUR_SPACE_ID

# Contentful Content Management API (CMA) Access Token
# WordPress からのデータを Contentful に書き込むために必須のトークンです。
# 個人設定 (Personal settings) -> Access Tokens から生成可能です。
CONTENTFUL_MANAGEMENT_TOKEN=YOUR_MANAGEMENT_TOKEN

# Contentful Content Delivery API (CDA) Access Token (オプション: 読み込み用)
CONTENTFUL_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# Contentful Content Preview API (CPA) Access Token (オプション: プレビュー用)
CONTENTFUL_PREVIEW_ACCESS_TOKEN=YOUR_PREVIEW_ACCESS_TOKEN

# Contentful Environment ID (デフォルトは master)
CONTENTFUL_ENVIRONMENT=master

# Contentful Default Locale (デフォルトは ja-JP)
CONTENTFUL_LOCALE=ja-JP
